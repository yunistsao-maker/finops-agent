# scripts/deploy-ui.sh writes .env.production from the CloudFormation outputs; copy to .env.local for `npm run dev`
VITE_REGION=us-east-1
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_IDENTITY_POOL_ID=us-east-1:00000000-0000-0000-0000-000000000000
VITE_GUEST_ACCESS=true
VITE_GUEST_ROLE_ARN=arn:aws:iam::123456789012:role/AgentCore-FinopsAgent-def-FinopsUiIdentitiesUnauthe-XXXXXXXX
VITE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/FinopsAgent_finops_agent-XXXXXXXXXX
