{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "FinopsAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "FinopsAgent"
  },
  "runtimes": [
    {
      "name": "finops_agent",
      "description": "FinOps analyst: daily AWS cost data split into LLM, infrastructure, networking and project costs",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/finops_agent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "MODEL_ID",
          "value": "global.anthropic.claude-sonnet-5-5"
        },
        {
          "name": "MAX_TOKENS",
          "value": "8000"
        },
        {
          "name": "MAX_LIVE_CE_CALLS",
          "value": "3"
        }
      ],
      "tags": {
        "app": "aws-finops-agent"
      },
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 3600
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
